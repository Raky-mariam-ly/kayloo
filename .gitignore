# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environments (Highly recommended to ignore)
.venv/
venv/
ENV/
env/
node_modules/
package.json
package-lock.json

# Environment variables (Sensitive data)
.env
.env.*

# Distribution / packaging
dist/
build/
*.egg-info/

# Unit test / coverage reports
.pytest_cache/
.coverage
htmlcov/

# Editor/IDE specific (e.g., VS Code, PyCharm)
.vscode/
.idea/

# Database files (e.g., SQLite)
*.db
*.sqlite3

# Logs
*.log
web_logs.txt

# Claude & Github config
.claude/
.github/

